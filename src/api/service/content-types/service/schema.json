{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "detailTitle": {
      "type": "string"
    },
    "detailDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "showInNavigation": {
      "type": "boolean",
      "default": true
    },
    "navigationOrder": {
      "type": "integer",
      "default": 0
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "lowboy",
        "platform",
        "extendable",
        "modular",
        "oversized",
        "special-project"
      ]
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "available",
        "busy",
        "maintenance"
      ],
      "default": "available"
    },
    "attributes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.attribute"
    },
    "cardHighlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.card-highlight"
    },
    "technicalAttributes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.technical-attribute"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.tag"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "sections.feature"
    },
    "configurations": {
      "type": "component",
      "repeatable": true,
      "component": "sections.configuration"
    },
    "relatedServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "inversedBy": "relatedToServices"
    },
    "relatedToServices": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "mappedBy": "relatedServices"
    }
  }
}
